# Thoth OSINT Platform - Environment Variables
# Duplicate this file as .env in product/backend/ and product/frontend/

DEBUG=false
LOG_LEVEL=INFO

# Database
DB_URL=sqlite+aiosqlite:///./data/thoth.db

# Redis (optional, for rate limiting)
REDIS_URL=redis://redis:6379/0

# API Keys (payants - à configurer)
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
IPINFO_API_KEY=

# Proxy SOCKS5 optionnel pour anonymisation
PROXY_URL=

# Timeouts
MAX_TIMEOUT=30
MAX_RETRIES=3
RATE_LIMIT_RPS=2.0

# Stockage
REPORT_STORAGE_PATH=/data/reports

# Frontend
VITE_API_BASE_URL=http://localhost:8000
