version: "3.9"

services:
  gateway:
    build:
      context: ../backend
      dockerfile: ../docker/Dockerfile.service
    container_name: thoth-gateway
    command: uvicorn gateway.main:app --host 0.0.0.0 --port 8000 --reload
    ports:
      - "8000:8000"
    env_file:
      - ../backend/.env
    volumes:
      - ../backend:/app
      - thoth_data:/data
    depends_on:
      - breach-lookup
      - social-harvester
      - dns-investigator
      - ip-geoloc
    restart: unless-stopped

  breach-lookup:
    build:
      context: ../backend
      dockerfile: ../docker/Dockerfile.service
    container_name: thoth-breach-lookup
    command: uvicorn services.breach_lookup.main:app --host 0.0.0.0 --port 8001 --reload
    ports:
      - "8001:8001"
    env_file:
      - ../backend/.env
    volumes:
      - ../backend:/app
      - thoth_data:/data
    restart: unless-stopped

  social-harvester:
    build:
      context: ../backend
      dockerfile: ../docker/Dockerfile.service
    container_name: thoth-social-harvester
    command: uvicorn services.social_harvester.main:app --host 0.0.0.0 --port 8002 --reload
    ports:
      - "8002:8002"
    env_file:
      - ../backend/.env
    volumes:
      - ../backend:/app
      - thoth_data:/data
    restart: unless-stopped

  dns-investigator:
    build:
      context: ../backend
      dockerfile: ../docker/Dockerfile.service
    container_name: thoth-dns-investigator
    command: uvicorn services.dns_investigator.main:app --host 0.0.0.0 --port 8003 --reload
    ports:
      - "8003:8003"
    env_file:
      - ../backend/.env
    volumes:
      - ../backend:/app
      - thoth_data:/data
    restart: unless-stopped

  ip-geoloc:
    build:
      context: ../backend
      dockerfile: ../docker/Dockerfile.service
    container_name: thoth-ip-geoloc
    command: uvicorn services.ip_geoloc.main:app --host 0.0.0.0 --port 8004 --reload
    ports:
      - "8004:8004"
    env_file:
      - ../backend/.env
    volumes:
      - ../backend:/app
      - thoth_data:/data
    restart: unless-stopped

  frontend:
    build:
      context: ../frontend
      dockerfile: ../docker/Dockerfile.frontend
    container_name: thoth-frontend
    ports:
      - "3000:80"
    env_file:
      - ../frontend/.env
    restart: unless-stopped

volumes:
  thoth_data:
